// @id=wr_1788491201887135893 @name=foot
window-rule {
    match app-id="^foot$"
    open-maximized true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
